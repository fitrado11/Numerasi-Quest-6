# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# On Vercel, add this in Project Settings -> Environment Variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# POSTGRES_URL / DATABASE_URL: Optional locally (falls back to SQLite),
# REQUIRED for persistent database storage on Vercel (e.g., Neon Postgres / Supabase).
POSTGRES_URL=""
DATABASE_URL=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
